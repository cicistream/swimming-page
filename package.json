{
  "name": "swimming-page",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "map:keep:swim-probe": "node scripts/map-keep-swim-probe.mjs",
    "probe:fit:swim-fields": "python3 scripts/probe_fit_swim_fields.py",
    "probe:keep:swimming": "node scripts/probe-keep-swimming.mjs",
    "sync:keep": "node scripts/sync-keep-swim-probe.mjs",
    "sync:huawei": "node scripts/sync-huawei-export.mjs",
    "test": "node --test",
    "dev": "npm run build:data && vite",
    "dev:keep": "SWIM_PROVIDER_OVERRIDE=keep_swim_probe npm run build:data && vite",
    "build": "npm run build:data && tsc -b && vite build",
    "preview": "vite preview",
    "worker:dev": "npx wrangler dev",
    "worker:deploy": "npx wrangler deploy"
  },
  "dependencies": {
    "fast-xml-parser": "^5.5.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
