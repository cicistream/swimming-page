{
  "profile": {
    "name": "Cici Stream",
    "headline": "Deep water performance archive",
    "summary": "Pool sessions, normalized and published as a living swim archive.",
    "location": "Shanghai, China"
  },
  "display": {
    "showPreciseTime": false,
    "showExactLocation": false,
    "showNotes": false,
    "showRawPayload": false
  },
  "provider": {
    "selected": "keep_swim_probe",
    "capabilityMatrix": {
      "sample_json": {
        "label": "Sample JSON",
        "supportsAuth": false,
        "supportsListActivities": true,
        "supportsActivityDetail": true,
        "supportsAutomaticSync": true,
        "qualityScore": 5
      },
      "huawei_health": {
        "label": "Huawei Health",
        "supportsAuth": true,
        "supportsListActivities": true,
        "supportsActivityDetail": true,
        "supportsAutomaticSync": true,
        "qualityScore": 8
      },
      "keep_swim_probe": {
        "label": "Keep",
        "supportsAuth": true,
        "supportsListActivities": true,
        "supportsActivityDetail": false,
        "supportsAutomaticSync": false,
        "qualityScore": 7
      }
    },
    "sampleJson": {
      "path": "sample-data/swims.json"
    },
    "huaweiHealth": {
      "mode": "health_kit_scaffold",
      "importPath": "",
      "rawDataPath": "data/sources/huawei-health/export.json",
      "apiScaffoldPath": "data/sources/huawei-health/api-scaffold.json",
      "syncMetaPath": "data/sources/huawei-health/sync-meta.json",
      "tokenCachePath": "data/sources/huawei-health/token-cache.json",
      "timezone": "Asia/Shanghai",
      "credentialsEnv": {
        "clientIdEnv": "HUAWEI_HEALTH_CLIENT_ID",
        "clientSecretEnv": "HUAWEI_HEALTH_CLIENT_SECRET",
        "redirectUriEnv": "HUAWEI_HEALTH_REDIRECT_URI"
      },
      "oauthEndpoints": {
        "authorizationUrl": "",
        "tokenUrl": "https://oauth-login.cloud.huawei.com/oauth2/v3/token",
        "scope": ""
      },
      "apiEndpoints": {
        "activitiesUrl": "https://health-api.cloud.huawei.com/healthkit/v2/activityRecords",
        "activityDetailUrl": "",
        "swimTypeParam": "swimming.pool",
        "detailDataType": "com.huawei.activity.feature.swimming.pool",
        "sourceType": "",
        "activityIdParam": "activityId"
      }
    },
    "keepSwimProbe": {
      "path": "data/sources/keep-probe/canonical-swims.draft.json"
    }
  }
}
